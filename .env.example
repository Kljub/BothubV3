# Copy to .env and adjust. BotHub runs in three containers: app, bot, redis.

# Public port of the dashboard (the only public port)
DASHBOARD_PORT=8080

# Optional: create the admin user on first start instead of the setup wizard
BOTHUB_ADMIN_USER=
BOTHUB_ADMIN_PASSWORD=

# Default UI language
BOTHUB_DEFAULT_LOCALE=en


# Time zone for times shown in the dashboard
TZ=UTC

# Shared secret for the internal endpoints (/internal/*) between the services,
# at least 32 characters (openssl rand -hex 32). Empty: the app container
# makes one and keeps it in ./data/internal.key.
BOTHUB_INTERNAL_KEY=

# Optional: updates from https://github.com/Kljub/BothubV3 (main), automatic
# updates and the restart policy (Admin -> Server settings -> Updates).
# Linux:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.update.yml
#   BOTHUB_HOST_DIR=  the output of pwd in this folder
#   DOCKER_GID=       the output of: getent group docker | cut -d: -f3
# Docker Desktop on Windows:
#   COMPOSE_PATH_SEPARATOR=;
#   COMPOSE_FILE=docker-compose.yml;docker-compose.update.yml
#   BOTHUB_HOST_DIR=/run/desktop/mnt/host/d/path/to/Bothub
#   DOCKER_GID=0
# Only the value goes after "=": no comments on the same line.
