# Copy to .env and adjust. BotHub runs in three containers: app, bot, redis.

# Public port of the dashboard (the only public port)
DASHBOARD_PORT=8080

# Optional: create the admin user on first start instead of the setup wizard
BOTHUB_ADMIN_USER=
BOTHUB_ADMIN_PASSWORD=

# Default UI language
BOTHUB_DEFAULT_LOCALE=en


# Time zone for times shown in the dashboard
TZ=UTC

# Shared secret for the internal endpoints (/internal/*) between the services,
# at least 32 characters. Generate: openssl rand -hex 32
BOTHUB_INTERNAL_KEY=

# Optional: the "Update now" button (Admin → Server settings → Updates).
# COMPOSE_FILE=docker-compose.yml:docker-compose.update.yml   (Windows: ; instead of :)
# BOTHUB_HOST_DIR=/opt/bothub          (Docker Desktop on Windows: /run/desktop/mnt/host/d/path/to/Bothub)
# DOCKER_GID=999                       (Linux: getent group docker | cut -d: -f3)
# BOTHUB_GIT_TOKEN=                    (only for a private repository)
