# Copy to .env and adjust. All services read their addresses only from ENV,
# so the same code runs in docker-compose and later in a single AMP image.

# Public port of the dashboard (the only public port)
DASHBOARD_PORT=8080

# Optional: create the admin user on first start instead of the setup wizard
BOTHUB_ADMIN_USER=
BOTHUB_ADMIN_PASSWORD=

# Default UI language
BOTHUB_DEFAULT_LOCALE=en

# Phase 1: run the dashboard against the in-memory mock API instead of the PHP API
# COMPOSE_PROFILES=mock
# API_URL=http://mockapi:9000

# Time zone for times shown in the dashboard
TZ=UTC

# Shared secret for the internal endpoints (/internal/*) between the services,
# at least 32 characters. Generate: openssl rand -hex 32
BOTHUB_INTERNAL_KEY=
