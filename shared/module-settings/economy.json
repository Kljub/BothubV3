{
  "module": "economy",
  "fields": [
    {
      "key": "currencies",
      "type": "list",
      "max": 10,
      "titleField": "name",
      "hint": true,
      "unique": [
        "key"
      ],
      "item": [
        {
          "key": "name",
          "type": "text",
          "max": 40,
          "required": true
        },
        {
          "key": "key",
          "type": "text",
          "max": 32,
          "pattern": "^[a-z0-9]{1,32}$",
          "required": true
        },
        {
          "key": "emoji",
          "type": "text",
          "max": 64
        }
      ]
    },
    {
      "key": "dailyBonus",
      "type": "number",
      "min": 0,
      "max": 1000000,
      "default": 100,
      "hint": true
    },
    {
      "key": "bankInterest",
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 1,
      "hint": true
    },
    {
      "key": "messageRewards",
      "type": "bool",
      "default": false,
      "hint": true
    },
    {
      "key": "messageCooldown",
      "type": "number",
      "min": 1,
      "max": 1440,
      "default": 1,
      "hint": true,
      "showIf": {
        "messageRewards": [
          "true"
        ]
      }
    },
    {
      "key": "messageAmount",
      "type": "number",
      "min": 1,
      "max": 100000,
      "default": 5,
      "showIf": {
        "messageRewards": [
          "true"
        ]
      }
    },
    {
      "key": "lotteryChannel",
      "type": "channel",
      "channelTypes": [
        "text",
        "announcement"
      ],
      "hint": true
    },
    {
      "key": "lotteryPrice",
      "type": "number",
      "min": 0,
      "max": 1000000,
      "default": 100
    },
    {
      "key": "lotteryTime",
      "type": "text",
      "max": 5,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "default": "20:00",
      "hint": true
    },
    {
      "key": "successColor",
      "type": "color",
      "default": "#22c55e"
    },
    {
      "key": "mainColor",
      "type": "color",
      "default": "#5865f2"
    },
    {
      "key": "alertColor",
      "type": "color",
      "default": "#f59e0b"
    },
    {
      "key": "shop",
      "type": "list",
      "max": 50,
      "titleField": "name",
      "hint": true,
      "unique": [
        "key"
      ],
      "item": [
        {
          "key": "name",
          "type": "text",
          "max": 64,
          "required": true
        },
        {
          "key": "key",
          "type": "text",
          "max": 32,
          "pattern": "^[a-z0-9_-]{1,32}$",
          "required": true
        },
        {
          "key": "description",
          "type": "text",
          "max": 2000,
          "multiline": true
        },
        {
          "key": "price",
          "type": "number",
          "min": 0,
          "max": 1000000000,
          "default": 100
        },
        {
          "key": "currency",
          "type": "text",
          "max": 32,
          "pattern": "^[a-z0-9]{0,32}$"
        },
        {
          "key": "limit",
          "type": "number",
          "min": 0,
          "max": 100000,
          "default": 0
        },
        {
          "key": "type",
          "type": "select",
          "options": [
            "role",
            "usable",
            "static"
          ],
          "default": "role"
        },
        {
          "key": "roles",
          "type": "roles",
          "max": 5
        },
        {
          "key": "destroyOnUse",
          "type": "bool",
          "default": false
        },
        {
          "key": "allowMultiple",
          "type": "bool",
          "default": false
        },
        {
          "key": "useOnBuy",
          "type": "bool",
          "default": true
        },
        {
          "key": "unlisted",
          "type": "bool",
          "default": false
        },
        {
          "key": "image",
          "type": "text",
          "max": 500,
          "pattern": "^https://\\S+$"
        }
      ]
    },
    {
      "key": "roles",
      "type": "list",
      "max": 25,
      "titleField": "amount",
      "hint": true,
      "item": [
        {
          "key": "amount",
          "type": "number",
          "min": 0,
          "max": 1000000000,
          "default": 10000,
          "required": true
        },
        {
          "key": "role",
          "type": "role",
          "required": true
        }
      ]
    }
  ]
}
