{
  "module": "kick-notifs",
  "integration": "kick",
  "integrationOptional": true,
  "fields": [
    {
      "key": "streamers",
      "type": "list",
      "max": 25,
      "titleField": "slug",
      "hint": true,
      "item": [
        {
          "key": "slug",
          "type": "text",
          "max": 30,
          "pattern": "^[A-Za-z0-9_-]{2,30}$",
          "required": true
        },
        {
          "key": "channel",
          "type": "channel",
          "channelTypes": [
            "text",
            "announcement"
          ],
          "required": true
        },
        {
          "key": "mentionRoles",
          "type": "roles",
          "max": 5
        },
        {
          "key": "message",
          "type": "message",
          "default": {
            "mode": "embed",
            "content": "🟢 **{streamer}** is live on Kick!",
            "title": "{title}",
            "description": "Category: **{category}**\n{url}",
            "color": "#53fc18",
            "image": "{thumbnail}",
            "footer": "Kick"
          },
          "vars": [
            "server",
            "server.id",
            "members",
            "streamer",
            "title",
            "category",
            "url",
            "viewers",
            "thumbnail"
          ]
        }
      ],
      "unique": [
        "slug",
        "channel"
      ]
    }
  ]
}
