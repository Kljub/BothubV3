        "user",
        "user.mention",
        "user.name",
        "user.id",
        "user.avatar",
        "server",
        "server.id",
        "members",
        "level",
        "level.old"
      ]
    },
    {
      "key": "clearOnLeave",
      "type": "bool",
      "default": false
    },
    {
      "key": "channelMode",
      "type": "select",
      "options": [
        "all",
        "except",
        "only"
      ],
      "default": "all"
    },
    {
      "key": "channels",
      "type": "channels",
      "channelTypes": [
        "text",
        "announcement",
        "forum",
        "voice"
      ],
      "max": 50,
      "showIf": {
        "channelMode": [
          "except",
          "only"
        ]
      }
    },
    {
      "key": "roleMode",
      "type": "select",
      "options": [
        "all",
        "except",
        "only"
      ],
      "default": "all"
