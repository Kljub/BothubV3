      "key": "rewards",
      "type": "list",
      "max": 50,
      "titleField": "level",
      "item": [
        {
          "key": "level",
          "type": "number",
          "min": 1,
          "max": 10000,
          "default": 5
        },
        {
          "key": "role",
          "type": "role"
        },
        {
          "key": "once",
          "type": "bool",
          "default": false
        }
      ]
