      "hint": true,
      "showIf": {
        "curve": [
          "custom"
        ]
      }
    },
    {
      "key": "maxLevel",
      "type": "number",
      "min": 0,
      "max": 10000,
      "default": 0
    },
    {
      "key": "voiceXp",
      "type": "bool",
      "default": false
