{
  "module": "leveling",
  "fields": [
    {
      "key": "minXp",
      "type": "number",
      "min": 0,
      "max": 1000,
      "default": 15
    },
    {
      "key": "maxXp",
      "type": "number",
      "min": 0,
      "max": 1000,
      "default": 25
    },
    {
      "key": "cooldown",
