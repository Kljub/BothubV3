    {
      "key": "voiceXpPerMinute",
      "type": "number",
      "min": 1,
      "max": 1000,
      "default": 5,
      "showIf": {
        "voiceXp": [
          "true"
        ]
      }
    },
    {
      "key": "voiceMinMembers",
      "type": "number",
      "min": 1,
      "max": 25,
      "default": 1,
      "hint": true,
      "showIf": {
        "voiceXp": [
          "true"
        ]
      }
    },
    {
      "key": "levelUp",
