      "default": 60
    },
    {
      "key": "curve",
      "type": "select",
      "options": [
        "linear",
        "custom"
      ],
      "default": "linear"
    },
    {
      "key": "baseXp",
      "type": "number",
      "min": 10,
      "max": 100000,
      "default": 100,
      "showIf": {
        "curve": [
          "linear"
        ]
      }
    },
    {
      "key": "stepXp",
      "type": "number",
      "min": 0,
      "max": 100000,
      "default": 50,
      "showIf": {
        "curve": [
          "linear"
        ]
      }
    },
    {
