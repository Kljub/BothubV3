      "options": [
        "off",
        "current",
        "channel",
        "dm"
      ],
      "default": "current"
    },
    {
      "key": "levelUpChannel",
      "type": "channel",
      "channelTypes": [
        "text",
        "announcement"
      ],
      "showIf": {
        "levelUp": [
          "channel"
        ]
      }
    },
    {
      "key": "levelUpMessage",
      "type": "text",
