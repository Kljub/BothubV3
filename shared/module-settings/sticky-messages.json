{
  "module": "sticky-messages",
  "fields": [
    {
      "key": "stickies",
      "type": "list",
      "max": 25,
      "titleField": "channel",
      "item": [
        {
          "key": "channel",
          "type": "channel",
          "channelTypes": [
            "text",
            "announcement"
          ]
        },
        {
          "key": "message",
          "type": "message",
          "default": {
            "mode": "embed",
            "title": "📌 Sticky message",
            "description": "Please read the rules.",
            "color": "#a78bfa"
          }
        },
        {
          "key": "every",
          "type": "number",
          "min": 1,
          "max": 100,
          "default": 10
        }
      ],
      "unique": [
        "channel"
      ]
    },
    {
      "key": "reaction",
      "type": "emojis",
      "max": 1
    }
  ]
}
