{
  "module": "twitch-notifs",
  "integration": "twitch",
  "fields": [
    {
      "key": "streamers",
      "type": "list",
      "max": 25,
      "titleField": "login",
      "hint": true,
      "item": [
        {
          "key": "login",
          "type": "text",
          "max": 25,
          "pattern": "^[A-Za-z0-9_]{3,25}$",
          "required": true
        },
        {
          "key": "channel",
          "type": "channel",
          "channelTypes": [
            "text",
            "announcement"
          ],
          "required": true
        },
        {
          "key": "mentionRoles",
          "type": "roles",
          "max": 5
        },
        {
          "key": "message",
          "type": "message",
          "default": {
            "mode": "embed",
            "content": "🔴 **{streamer}** is live on Twitch!",
            "title": "{title}",
            "description": "Playing **{game}**\n{url}",
            "color": "#9146ff",
            "image": "{thumbnail}",
            "footer": "Twitch"
          },
          "vars": [
            "server",
            "server.id",
            "members",
            "streamer",
            "streamer.login",
            "streamer.avatar",
            "title",
            "game",
            "url",
            "viewers",
            "thumbnail"
          ]
        }
      ],
      "unique": [
        "login",
        "channel"
      ]
    },
    {
      "key": "dropsGames",
      "type": "list",
      "max": 25,
      "titleField": "game",
      "hint": true,
      "item": [
        {
          "key": "game",
          "type": "text",
          "max": 100,
          "required": true
        },
        {
          "key": "channel",
          "type": "channel",
          "channelTypes": [
            "text",
            "announcement"
          ],
          "required": true
        },
        {
          "key": "role",
          "type": "role"
        }
      ]
    }
  ]
}
