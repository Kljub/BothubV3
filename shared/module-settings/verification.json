{
  "module": "verification",
  "fields": [
    {
      "key": "channel",
      "type": "channel",
      "channelTypes": [
        "text"
      ]
    },
    {
      "key": "type",
      "type": "select",
      "options": [
        "button",
        "captcha",
        "number"
      ],
      "default": "button"
    },
    {
      "key": "panel",
      "type": "message",
      "default": {
        "mode": "embed",
        "title": "✅ Verification",
        "description": "Press the button below to get access to {server}.",
        "color": "#4ade80"
      },
      "vars": [
        "server",
        "server.id",
        "members"
      ]
    },
    {
      "key": "buttonLabel",
      "type": "text",
      "max": 80,
      "default": "Verify"
    },
    {
      "key": "role",
      "type": "role",
      "hint": true
    },
    {
      "key": "removeRole",
      "type": "role"
    },
    {
      "key": "successMessage",
      "type": "text",
      "max": 1000,
      "default": "You are verified. Welcome to {server}!",
      "vars": [
        "user",
        "user.mention",
        "user.name",
        "user.id",
        "user.avatar",
        "server",
        "server.id",
        "members"
      ]
    },
    {
      "key": "failMessage",
      "type": "text",
      "max": 1000,
      "default": "That was not correct. Please try again.",
      "vars": [
        "user",
        "user.mention",
        "user.name",
        "user.id",
        "user.avatar",
        "server",
        "server.id",
        "members"
      ]
    }
  ]
}
