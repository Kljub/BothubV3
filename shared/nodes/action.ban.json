{
  "$schema": "../node-definition.schema.json",
  "type": "action.ban",
  "version": 1,
  "category": "action",
  "group": "server",
  "order": 720,
  "color": "orange",
  "icon": "▶︎",
  "labelKey": "builder.node.action_ban.label",
  "descriptionKey": "builder.node.action_ban.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "delete_messages": {
        "type": "string",
        "enum": [
          "none",
          "1h",
          "6h",
          "12h",
          "24h",
          "3d",
          "7d"
        ],
        "default": "none",
        "x-labelKey": "builder.cfg.delete_messages",
        "x-enumKey": "builder.enum.delete_messages"
      },
      "ban_absent": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.ban_absent"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "undo_after": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^([0-9]+[smhd]|\\{[A-Za-z0-9_.:-]+\\})$",
        "x-widget": "undo",
        "x-labelKey": "builder.undo.title",
        "x-undoTitleKey": "builder.undo.ban",
        "x-undoHintKey": "builder.undo.ban_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
