{
  "$schema": "../node-definition.schema.json",
  "type": "action.ban_info",
  "version": 1,
  "category": "action",
  "group": "server",
  "order": 665,
  "color": "orange",
  "icon": "▶︎",
  "labelKey": "builder.node.action_ban_info.label",
  "descriptionKey": "builder.node.action_ban_info.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".banned",
      "labelKey": "builder.result.ban_info.0"
    },
    {
      "suffix": ".reason",
      "labelKey": "builder.result.ban_info.1"
    },
    {
      "suffix": ".user",
      "labelKey": "builder.result.ban_info.2"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
