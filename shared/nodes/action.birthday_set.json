{
  "$schema": "../node-definition.schema.json",
  "type": "action.birthday_set",
  "version": 1,
  "category": "action",
  "group": "birthday",
  "order": 890,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_birthday_set.label",
  "descriptionKey": "builder.node.action_birthday_set.description",
  "module": "birthday",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
