  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "date": {
        "type": "string",
        "maxLength": 10,
        "x-labelKey": "builder.cfg.date",
        "x-placeholder": "24.12.",
        "x-hintKey": "builder.cfg.date_hint"
      }
    }
