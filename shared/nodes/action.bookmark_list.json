{
  "$schema": "../node-definition.schema.json",
  "type": "action.bookmark_list",
  "version": 1,
  "category": "action",
  "group": "bookmarks",
  "order": 2610,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_bookmark_list.label",
  "descriptionKey": "builder.node.action_bookmark_list.description",
  "module": "bookmarks",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.action_bookmark_list.0"
    },
    {
      "suffix": ".count",
      "labelKey": "builder.result.action_bookmark_list.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25,
        "default": 10,
        "x-labelKey": "builder.cfg.bookmark_limit"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
