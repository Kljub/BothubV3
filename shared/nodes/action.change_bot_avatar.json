      "banner": {
        "type": "string",
        "maxLength": 2000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.banner",
        "x-hintKey": "builder.cfg.change_bot_avatar_banner_hint"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
