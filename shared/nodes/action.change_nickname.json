{
  "$schema": "../node-definition.schema.json",
  "type": "action.change_nickname",
  "version": 1,
  "category": "action",
  "group": "server",
  "order": 630,
  "color": "orange",
  "icon": "▶︎",
  "labelKey": "builder.node.action_change_nickname.label",
  "descriptionKey": "builder.node.action_change_nickname.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "nickname": {
        "type": "string",
        "maxLength": 32,
        "x-labelKey": "builder.cfg.nickname",
        "x-hintKey": "builder.cfg.nickname_hint"
      },
      "undo_after": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^([0-9]+[smhd]|\\{[A-Za-z0-9_.:-]+\\})$",
        "x-widget": "undo",
        "x-labelKey": "builder.undo.title",
        "x-undoTitleKey": "builder.undo.change_nickname",
        "x-undoHintKey": "builder.undo.change_nickname_hint"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
