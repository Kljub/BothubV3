{
  "$schema": "../node-definition.schema.json",
  "type": "action.clone_channel",
  "version": 1,
  "category": "action",
  "group": "channel",
  "order": 505,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_clone_channel.label",
  "descriptionKey": "builder.node.action_clone_channel.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".id",
      "labelKey": "builder.result.clone_channel.0"
    },
    {
      "suffix": ".name",
      "labelKey": "builder.result.clone_channel.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 200,
        "default": "{channel.id}",
        "x-labelKey": "builder.cfg.channel",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "channel"
      },
      "name": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.clone_channel_name",
        "x-hintKey": "builder.cfg.clone_channel_name_hint"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
