{
  "$schema": "../node-definition.schema.json",
  "type": "action.counting_set",
  "version": 1,
  "category": "action",
  "group": "counting",
  "order": 2710,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_counting_set.label",
  "descriptionKey": "builder.node.action_counting_set.description",
  "module": "counting",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.action_counting_set.0"
    },
    {
      "suffix": ".channel",
      "labelKey": "builder.result.action_counting_set.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.counting_channel",
        "x-hintKey": "builder.cfg.counting_channel_hint",
        "x-ref": "channel"
      },
      "number": {
        "type": "string",
        "maxLength": 40,
        "default": "0",
        "x-labelKey": "builder.cfg.counting_number",
        "x-hintKey": "builder.cfg.counting_number_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
