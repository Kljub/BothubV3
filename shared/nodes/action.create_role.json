{
  "$schema": "../node-definition.schema.json",
  "type": "action.create_role",
  "version": 1,
  "category": "action",
  "group": "role",
  "order": 470,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_create_role.label",
  "descriptionKey": "builder.node.action_create_role.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.create_role.0"
    },
    {
      "suffix": ".id",
      "labelKey": "builder.result.create_role.1"
    },
    {
      "suffix": ".name",
      "labelKey": "builder.result.create_role.2"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.name"
      },
      "color": {
        "type": "string",
        "maxLength": 7,
        "x-labelKey": "builder.cfg.color",
        "x-placeholder": "#5865f2"
      },
      "hoist": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.hoist"
      },
      "mentionable": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.mentionable"
      },
      "undo_after": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^([0-9]+[smhd]|\\{[A-Za-z0-9_.:-]+\\})$",
        "x-widget": "undo",
        "x-labelKey": "builder.undo.title",
        "x-undoTitleKey": "builder.undo.create_role",
        "x-undoHintKey": "builder.undo.create_role_hint"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
