{
  "$schema": "../node-definition.schema.json",
  "type": "action.daily_challenges",
  "version": 1,
  "category": "action",
  "group": "leveling",
  "order": 910,
  "color": "orange",
  "icon": "🎯",
  "labelKey": "builder.node.action_daily_challenges.label",
  "descriptionKey": "builder.node.action_daily_challenges.description",
  "module": "achievements",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.daily_challenges.0"
    },
    {
      "suffix": ".done",
      "labelKey": "builder.result.daily_challenges.1"
    },
    {
      "suffix": ".total",
      "labelKey": "builder.result.daily_challenges.2"
    },
    {
      "suffix": ".streak",
      "labelKey": "builder.result.daily_challenges.3"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 100,
        "default": "{user.id}",
        "x-ref": "member",
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
