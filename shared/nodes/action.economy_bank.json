{
  "$schema": "../node-definition.schema.json",
  "type": "action.economy_bank",
  "version": 1,
  "category": "action",
  "group": "economy",
  "order": 941,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_economy_bank.label",
  "descriptionKey": "builder.node.action_economy_bank.description",
  "module": "economy",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.economy_bank.0"
    },
    {
      "suffix": ".wallet",
      "labelKey": "builder.result.economy_bank.wallet"
    },
    {
      "suffix": ".bank",
      "labelKey": "builder.result.economy_bank.bank"
    },
    {
      "suffix": ".interest",
      "labelKey": "builder.result.economy_bank.interest"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "show",
          "deposit",
          "withdraw"
        ],
        "default": "show",
        "x-labelKey": "builder.cfg.economy_bank_mode"
      },
      "amount": {
        "type": "string",
        "maxLength": 20,
        "x-labelKey": "builder.cfg.economy_amount_all"
      },
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
