{
  "$schema": "../node-definition.schema.json",
  "type": "action.economy_lottery",
  "version": 1,
  "category": "action",
  "group": "economy",
  "order": 946,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_economy_lottery.label",
  "descriptionKey": "builder.node.action_economy_lottery.description",
  "module": "economy",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.economy_lottery.0"
    },
    {
      "suffix": ".pot",
      "labelKey": "builder.result.economy_lottery.pot"
    },
    {
      "suffix": ".tickets",
      "labelKey": "builder.result.economy_lottery.tickets"
    },
    {
      "suffix": ".mine",
      "labelKey": "builder.result.economy_lottery.mine"
    },
    {
      "suffix": ".balance",
      "labelKey": "builder.result.economy_lottery.balance"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "view",
          "buy"
        ],
        "default": "view",
        "x-labelKey": "builder.cfg.economy_lottery_mode"
      },
      "tickets": {
        "type": "string",
        "maxLength": 10,
        "x-labelKey": "builder.cfg.economy_tickets"
      },
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
