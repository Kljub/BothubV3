{
  "$schema": "../node-definition.schema.json",
  "type": "action.edit_channel",
  "version": 1,
  "category": "action",
  "group": "channel",
  "order": 490,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_edit_channel.label",
  "descriptionKey": "builder.node.action_edit_channel.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.channel",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "channel",
        "default": "{channel.id}"
      },
      "name": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.name"
      },
      "topic": {
        "type": "string",
        "maxLength": 1024,
        "x-labelKey": "builder.cfg.topic",
        "x-multiline": true
      },
      "slowmode": {
        "type": "number",
        "minimum": 0,
        "x-labelKey": "builder.cfg.slowmode",
        "maximum": 21600
      },
      "nsfw": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.nsfw"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
