{
  "$schema": "../node-definition.schema.json",
  "type": "action.edit_component",
  "version": 1,
  "category": "action",
  "group": "advanced_messages",
  "order": 20,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_edit_component.label",
  "descriptionKey": "builder.node.action_edit_component.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.message",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "message"
      },
      "component_id": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.component_id",
        "x-mono": true
      },
      "label": {
        "type": "string",
        "maxLength": 80,
        "x-labelKey": "builder.cfg.label"
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.disabled"
      }
    }
  }
}
