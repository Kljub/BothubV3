      "icon": {
        "type": "string",
        "maxLength": 2000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.icon"
      },
      "banner": {
        "type": "string",
        "maxLength": 2000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.edit_server_banner",
        "x-hintKey": "builder.cfg.edit_server_banner_hint"
      },
      "splash": {
        "type": "string",
        "maxLength": 2000,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.splash",
        "x-hintKey": "builder.cfg.edit_server_splash_hint"
      },
      "description": {
        "type": "string",
        "maxLength": 120,
