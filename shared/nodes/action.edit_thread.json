{
  "$schema": "../node-definition.schema.json",
  "type": "action.edit_thread",
  "version": 1,
  "category": "action",
  "group": "thread",
  "order": 510,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_edit_thread.label",
  "descriptionKey": "builder.node.action_edit_thread.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "thread": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.thread",
        "x-hintKey": "builder.cfg.ref_hint"
      },
      "name": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.name"
      },
      "archived": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.archived"
      },
      "locked": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.locked"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
