{
  "$schema": "../node-definition.schema.json",
  "type": "action.edit_webhook",
  "version": 1,
  "category": "action",
  "group": "webhooks",
  "order": 1181,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_edit_webhook.label",
  "descriptionKey": "builder.node.action_edit_webhook.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".id",
      "labelKey": "builder.result.edit_webhook.0"
    },
    {
      "suffix": ".url",
      "labelKey": "builder.result.edit_webhook.1"
    },
    {
      "suffix": ".name",
      "labelKey": "builder.result.edit_webhook.2"
    },
    {
      "suffix": ".avatar",
      "labelKey": "builder.result.edit_webhook.3"
    },
    {
      "suffix": ".channel",
      "labelKey": "builder.result.edit_webhook.4"
    },
    {
      "suffix": ".channel_id",
      "labelKey": "builder.result.edit_webhook.5"
    },
    {
      "suffix": ".creator",
      "labelKey": "builder.result.edit_webhook.6"
    },
    {
      "suffix": ".created",
      "labelKey": "builder.result.edit_webhook.7"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webhook": {
        "type": "string",
        "maxLength": 300,
        "x-mono": true,
        "x-labelKey": "builder.cfg.webhook_ref",
        "x-hintKey": "builder.cfg.webhook_ref_hint",
        "x-placeholder": "{Hook.id}"
      },
      "name": {
        "type": "string",
        "maxLength": 80,
        "x-labelKey": "builder.cfg.clone_channel_name",
        "x-hintKey": "builder.cfg.edit_webhook_name_hint"
      },
      "avatar": {
        "type": "string",
        "maxLength": 2000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.webhook_avatar",
        "x-hintKey": "builder.cfg.edit_webhook_avatar_hint"
      },
      "channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.webhook_move",
        "x-hintKey": "builder.cfg.ref_optional_hint",
        "x-ref": "channel"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
