{
  "$schema": "../node-definition.schema.json",
  "type": "action.event_edit",
  "version": 1,
  "category": "action",
  "group": "events",
  "order": 570,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_event_edit.label",
  "descriptionKey": "builder.node.action_event_edit.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "event": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.event_scheduled_event",
        "x-hintKey": "builder.cfg.ref_hint"
      },
      "name": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.name"
      },
      "description": {
        "type": "string",
        "maxLength": 1000,
        "x-labelKey": "builder.cfg.description",
        "x-multiline": true
      },
      "start": {
        "type": "string",
        "maxLength": 40,
        "x-labelKey": "builder.cfg.start",
        "x-mono": true,
        "x-placeholder": "2026-12-24 18:00",
        "x-hintKey": "builder.cfg.start_hint"
      },
      "end": {
        "type": "string",
        "maxLength": 40,
        "x-labelKey": "builder.cfg.end",
        "x-mono": true,
        "x-placeholder": "2026-12-24 18:00",
        "x-hintKey": "builder.cfg.end_hint"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
