{
  "$schema": "../node-definition.schema.json",
  "type": "action.event_get",
  "version": 1,
  "category": "action",
  "group": "events",
  "order": 600,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_event_get.label",
  "descriptionKey": "builder.node.action_event_get.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".id",
      "labelKey": "builder.result.event_get.0"
    },
    {
      "suffix": ".url",
      "labelKey": "builder.result.event_get.1"
    },
    {
      "suffix": ".name",
      "labelKey": "builder.result.event_get.2"
    },
    {
      "suffix": ".start",
      "labelKey": "builder.result.event_get.3"
    },
    {
      "suffix": ".status",
      "labelKey": "builder.result.event_get.4"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "event": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.event_scheduled_event",
        "x-hintKey": "builder.cfg.ref_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
