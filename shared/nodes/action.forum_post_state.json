{
  "$schema": "../node-definition.schema.json",
  "type": "action.forum_post_state",
  "version": 1,
  "category": "action",
  "group": "thread",
  "order": 545,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_forum_post_state.label",
  "descriptionKey": "builder.node.action_forum_post_state.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".closed",
      "labelKey": "builder.result.forum_post_state.0"
    },
    {
      "suffix": ".locked",
      "labelKey": "builder.result.forum_post_state.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "thread": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.thread",
        "x-hintKey": "builder.cfg.ref_hint"
      },
      "state": {
        "type": "string",
        "enum": [
          "close",
          "reopen",
          "lock",
          "unlock",
          "close_lock",
          "reopen_unlock"
        ],
        "default": "close",
        "x-labelKey": "builder.cfg.post_state",
        "x-enumKey": "builder.enum.post_state"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
