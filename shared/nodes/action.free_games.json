      "embeds": {
        "type": "boolean",
        "default": true,
        "x-labelKey": "builder.cfg.free_games_embeds",
        "x-hintKey": "builder.cfg.free_games_embeds_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
