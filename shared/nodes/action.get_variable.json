{
  "$schema": "../node-definition.schema.json",
  "type": "action.get_variable",
  "version": 1,
  "category": "action",
  "group": "variables",
  "order": 95,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_get_variable.label",
  "descriptionKey": "builder.node.action_get_variable.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".exists",
      "labelKey": "builder.result.get_variable.0"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "var_name": {
        "type": "string",
        "maxLength": 64,
        "x-mono": true,
        "x-labelKey": "builder.cfg.var_name",
        "x-hintKey": "builder.cfg.var_name_hint",
        "x-placeholder": "coins"
      },
      "scope": {
        "type": "string",
        "enum": [
          "run",
          "user",
          "server",
          "global"
        ],
        "default": "run",
        "x-labelKey": "builder.cfg.scope",
        "x-enumKey": "builder.enum.scope"
      },
      "target_user": {
        "type": "string",
        "maxLength": 200,
        "x-advanced": true,
        "x-labelKey": "builder.cfg.target_user",
        "x-hintKey": "builder.cfg.target_user_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
