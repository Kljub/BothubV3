{
  "$schema": "../node-definition.schema.json",
  "type": "action.giveaway_create",
  "version": 1,
  "category": "action",
  "group": "giveaways",
  "order": 970,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_giveaway_create.label",
  "descriptionKey": "builder.node.action_giveaway_create.description",
  "module": "giveaway",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".id",
      "labelKey": "builder.result.giveaway_create.0"
    },
    {
      "suffix": ".url",
      "labelKey": "builder.result.giveaway_create.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.channel",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "channel"
      },
      "prize": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.prize"
      },
      "winners": {
        "type": "number",
        "minimum": 1,
        "x-labelKey": "builder.cfg.winners",
        "maximum": 50,
        "default": 1
      },
      "duration": {
        "type": "string",
        "maxLength": 20,
        "x-labelKey": "builder.cfg.duration",
        "x-placeholder": "10m",
        "x-hintKey": "builder.cfg.duration_hint"
      },
      "role": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.giveaway_role",
        "x-hintKey": "builder.cfg.giveaway_role_hint",
        "x-ref": "role"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  },
  "produces": "message"
}
