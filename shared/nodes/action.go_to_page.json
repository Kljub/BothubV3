{
  "$schema": "../node-definition.schema.json",
  "type": "action.go_to_page",
  "version": 1,
  "category": "action",
  "group": "other",
  "order": 820,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_go_to_page.label",
  "descriptionKey": "builder.node.action_go_to_page.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.message",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "message"
      },
      "page_action": {
        "type": "string",
        "enum": [
          "next",
          "previous",
          "first",
          "last",
          "page"
        ],
        "default": "next",
        "x-labelKey": "builder.cfg.page_action",
        "x-enumKey": "builder.enum.page_action"
      },
      "page": {
        "type": "number",
        "minimum": 1,
        "x-labelKey": "builder.cfg.page",
        "maximum": 1000,
        "default": 1,
        "x-showIf": {
          "page_action": [
            "page"
          ]
        }
      },
      "pages": {
        "type": "string",
        "maxLength": 8000,
        "x-labelKey": "builder.cfg.pages",
        "x-multiline": true,
        "x-hintKey": "builder.cfg.pages_hint"
      }
    }
  }
}
