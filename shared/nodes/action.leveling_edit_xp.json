{
  "$schema": "../node-definition.schema.json",
  "type": "action.leveling_edit_xp",
  "version": 1,
  "category": "action",
  "group": "leveling",
  "order": 1050,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_leveling_edit_xp.label",
  "descriptionKey": "builder.node.action_leveling_edit_xp.description",
  "module": "leveling",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "xp_mode": {
        "type": "string",
        "enum": [
          "add",
          "remove",
          "set"
        ],
        "default": "add",
        "x-labelKey": "builder.cfg.xp_mode",
        "x-enumKey": "builder.enum.xp_mode"
      },
      "amount": {
        "type": "number",
        "minimum": 0,
        "x-labelKey": "builder.cfg.amount_amount"
      }
    }
  }
}
