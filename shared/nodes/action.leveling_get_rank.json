{
  "$schema": "../node-definition.schema.json",
  "type": "action.leveling_get_rank",
  "version": 1,
  "category": "action",
  "group": "leveling",
  "order": 1060,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_leveling_get_rank.label",
  "descriptionKey": "builder.node.action_leveling_get_rank.description",
  "module": "leveling",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".level",
      "labelKey": "builder.result.leveling_get_rank.0"
    },
    {
      "suffix": ".xp",
      "labelKey": "builder.result.leveling_get_rank.1"
    },
    {
      "suffix": ".rank",
      "labelKey": "builder.result.leveling_get_rank.2"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.user",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "member",
        "default": "{user.id}"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
