{
  "$schema": "../node-definition.schema.json",
  "type": "action.lockdown",
  "version": 1,
  "category": "action",
  "group": "server",
  "order": 780,
  "color": "orange",
  "icon": "🔒",
  "labelKey": "builder.node.action_lockdown.label",
  "descriptionKey": "builder.node.action_lockdown.description",
  "module": "anticontrol",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.lockdown.0"
    },
    {
      "suffix": ".channels",
      "labelKey": "builder.result.lockdown.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "on",
          "off"
        ],
        "default": "on",
        "x-labelKey": "builder.cfg.lockdown_mode",
        "x-enumKey": "builder.enum.lockdown_mode"
      },
      "minutes": {
        "type": "string",
        "maxLength": 40,
        "default": "30",
        "x-labelKey": "builder.cfg.lockdown_minutes",
        "x-hintKey": "builder.cfg.lockdown_minutes_hint",
        "x-showIf": {
          "mode": [
            "on"
          ]
        }
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
