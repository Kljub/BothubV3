{
  "$schema": "../node-definition.schema.json",
  "type": "action.music_filter",
  "version": 1,
  "category": "action",
  "group": "music",
  "order": 320,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_music_filter.label",
  "descriptionKey": "builder.node.action_music_filter.description",
  "module": "music",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
