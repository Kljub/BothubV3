          "bassboost",
          "nightcore",
          "vaporwave",
          "8d",
          "karaoke",
          "tremolo",
          "vibrato",
          "lowpass"
        ],
        "default": "bassboost",
        "x-labelKey": "builder.cfg.filter",
        "x-enumKey": "builder.enum.filter"
      },
      "guild": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.guild",
        "x-hintKey": "builder.cfg.guild_hint"
      }
    }
  }
}
