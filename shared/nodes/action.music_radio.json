{
  "$schema": "../node-definition.schema.json",
  "type": "action.music_radio",
  "version": 1,
  "category": "action",
  "group": "music",
  "order": 175,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_music_radio.label",
  "descriptionKey": "builder.node.action_music_radio.description",
  "module": "music",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.action_music_radio.0"
    },
    {
      "suffix": ".country",
      "labelKey": "builder.result.action_music_radio.1"
    },
    {
      "suffix": ".tags",
      "labelKey": "builder.result.action_music_radio.2"
    },
    {
      "suffix": ".homepage",
      "labelKey": "builder.result.action_music_radio.3"
    },
    {
      "suffix": ".more",
      "labelKey": "builder.result.action_music_radio.4"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "station": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.radio_station"
      },
      "genre": {
        "type": "string",
        "maxLength": 50,
        "x-labelKey": "builder.cfg.radio_genre"
      },
      "country": {
        "type": "string",
        "maxLength": 2,
        "x-labelKey": "builder.cfg.radio_country"
      },
      "random": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.radio_random",
        "x-hintKey": "builder.cfg.radio_random_hint"
      },
      "mode": {
        "type": "string",
        "enum": [
          "replace",
          "queue"
        ],
        "default": "replace",
        "x-labelKey": "builder.cfg.radio_mode",
        "x-enumKey": "builder.enum.radio_mode"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
