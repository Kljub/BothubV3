{
  "$schema": "../node-definition.schema.json",
  "type": "action.music_recognize",
  "version": 1,
  "category": "action",
  "group": "music",
  "order": 177,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_music_recognize.label",
  "descriptionKey": "builder.node.action_music_recognize.description",
  "module": "music",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.action_music_recognize.0"
    },
    {
      "suffix": ".title",
      "labelKey": "builder.result.action_music_recognize.1"
    },
    {
      "suffix": ".artist",
      "labelKey": "builder.result.action_music_recognize.2"
    },
    {
      "suffix": ".album",
      "labelKey": "builder.result.action_music_recognize.3"
    },
    {
      "suffix": ".link",
      "labelKey": "builder.result.action_music_recognize.4"
    },
    {
      "suffix": ".source",
      "labelKey": "builder.result.action_music_recognize.5"
    },
    {
      "suffix": ".station",
      "labelKey": "builder.result.action_music_recognize.6"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "auto",
          "radio",
          "audio"
        ],
        "default": "auto",
        "x-labelKey": "builder.cfg.recognize_mode",
        "x-enumKey": "builder.enum.recognize_mode"
      },
      "acr_host": {
        "type": "string",
        "maxLength": 100,
        "default": "identify-eu-west-1.acrcloud.com",
        "x-labelKey": "builder.cfg.acr_host",
        "x-hintKey": "builder.cfg.acr_host_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
