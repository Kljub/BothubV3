{
  "$schema": "../node-definition.schema.json",
  "type": "action.note",
  "version": 1,
  "category": "action",
  "group": "other",
  "order": 830,
  "color": "grey",
  "icon": "▶︎",
  "labelKey": "builder.node.action_note.label",
  "descriptionKey": "builder.node.action_note.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "note": {
        "type": "string",
        "maxLength": 2000,
        "x-labelKey": "builder.cfg.note",
        "x-multiline": true
      },
      "style": {
        "type": "string",
        "enum": [
          "note",
          "info",
          "tip",
          "warning",
          "danger",
          "success"
        ],
        "default": "note",
        "x-labelKey": "builder.cfg.note_style",
        "x-enumKey": "builder.enum.note_style"
      },
      "color": {
        "type": "string",
        "pattern": "^(#[0-9a-fA-F]{6})?$",
        "x-labelKey": "builder.cfg.note_color",
        "x-hintKey": "builder.cfg.note_color_hint",
        "x-placeholder": "#facc15",
        "x-mono": true
      },
      "icon": {
        "type": "string",
        "maxLength": 64,
        "x-labelKey": "builder.cfg.note_icon",
        "x-widget": "emoji"
      }
    }
  }
}
