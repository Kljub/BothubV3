{
  "$schema": "../node-definition.schema.json",
  "type": "action.object_add_property",
  "version": 1,
  "category": "action",
  "group": "objects",
  "order": 1620,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_object_add_property.label",
  "descriptionKey": "builder.node.action_object_add_property.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "object": {
        "type": "string",
        "maxLength": 4000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.object",
        "x-hintKey": "builder.cfg.object_hint",
        "x-placeholder": "{Obj}"
      },
      "key": {
        "type": "string",
        "maxLength": 200,
        "x-mono": true,
        "x-labelKey": "builder.cfg.object_key",
        "x-hintKey": "builder.cfg.object_key_hint",
        "x-placeholder": "stats.level"
      },
      "value": {
        "type": "string",
        "maxLength": 2000,
        "x-labelKey": "builder.cfg.value",
        "x-multiline": true
      },
      "value_type": {
        "type": "string",
        "enum": [
          "auto",
          "text",
          "number",
          "boolean",
          "json"
        ],
        "default": "auto",
        "x-labelKey": "builder.cfg.value_type",
        "x-enumKey": "builder.enum.object_add_property_value_type"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
