  "category": "action",
  "group": "objects",
  "order": 1630,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_object_get_property.label",
  "descriptionKey": "builder.node.action_object_get_property.description",
  "inputs": [
