{
  "$schema": "../node-definition.schema.json",
  "type": "action.poll_results",
  "version": 1,
  "category": "action",
  "group": "polls",
  "order": 1100,
  "color": "blue",
  "icon": "▶︎",
  "labelKey": "builder.node.action_poll_results.label",
  "descriptionKey": "builder.node.action_poll_results.description",
  "module": "polls",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "poll": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.poll",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "message"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
