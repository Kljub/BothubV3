{
  "$schema": "../node-definition.schema.json",
  "type": "action.run_equation",
  "version": 1,
  "category": "action",
  "group": "variables",
  "order": 100,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_run_equation.label",
  "descriptionKey": "builder.node.action_run_equation.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "var_name": {
        "type": "string",
        "maxLength": 64,
        "x-labelKey": "builder.cfg.var_name",
        "x-mono": true,
        "x-placeholder": "coins",
        "x-hintKey": "builder.cfg.var_name_hint"
      },
      "math": {
        "type": "string",
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide",
          "modulo",
          "power",
          "set"
        ],
        "default": "add",
        "x-labelKey": "builder.cfg.math",
        "x-enumKey": "builder.enum.math"
      },
      "operand": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.operand",
        "x-placeholder": "5",
        "x-hintKey": "builder.cfg.operand_hint"
      },
      "scope": {
        "type": "string",
        "enum": [
          "run",
          "user",
          "server",
          "global"
        ],
        "default": "run",
        "x-labelKey": "builder.cfg.scope",
        "x-enumKey": "builder.enum.scope"
      }
    }
  }
}
