{
  "$schema": "../node-definition.schema.json",
  "type": "action.run_loop",
  "version": 1,
  "category": "action",
  "group": "loop",
  "order": 150,
  "color": "orange",
  "icon": "▶︎",
  "labelKey": "builder.node.action_run_loop.label",
  "descriptionKey": "builder.node.action_run_loop.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "each",
      "type": "flow",
      "labelKey": "builder.port.each"
    },
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.run_loop.0"
    },
    {
      "suffix": ".count",
      "labelKey": "builder.result.run_loop.1"
    },
    {
      "suffix": ".index",
      "labelKey": "builder.result.run_loop.2"
    },
    {
      "suffix": ".first",
      "labelKey": "builder.result.run_loop.3"
    },
    {
      "suffix": ".last",
      "labelKey": "builder.result.run_loop.4"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "loop": {
        "type": "string",
        "enum": [
          "count",
          "list"
        ],
        "default": "count",
        "x-labelKey": "builder.cfg.loop",
        "x-enumKey": "builder.enum.loop"
      },
      "count": {
        "type": "number",
        "minimum": 1,
        "x-labelKey": "builder.cfg.count",
        "maximum": 100,
        "default": 3,
        "x-showIf": {
          "loop": [
            "count"
          ]
        }
      },
      "list": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.list",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-showIf": {
          "loop": [
            "list"
          ]
        }
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
