{
  "$schema": "../node-definition.schema.json",
  "type": "action.send_webhook_message",
  "version": 1,
  "category": "action",
  "group": "webhooks",
  "order": 1185,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_send_webhook_message.label",
  "descriptionKey": "builder.node.action_send_webhook_message.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": ".id",
      "labelKey": "builder.result.send_webhook_message.0"
    },
    {
      "suffix": ".url",
      "labelKey": "builder.result.send_webhook_message.1"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webhook": {
        "type": "string",
        "maxLength": 300,
        "x-mono": true,
        "x-labelKey": "builder.cfg.webhook_ref",
        "x-hintKey": "builder.cfg.webhook_ref_hint",
        "x-placeholder": "{Hook.id}"
      },
      "message": {
        "type": "object",
        "default": {
          "mode": "normal",
          "content": ""
        },
        "x-labelKey": "builder.msg.what",
        "additionalProperties": false,
        "x-widget": "message",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "v2"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "embeds": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "title": {
                  "type": "string",
                  "maxLength": 256
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "description": {
                  "type": "string",
                  "maxLength": 4096
                },
                "author": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "icon_url": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                },
                "fields": {
                  "type": "array",
                  "maxItems": 25,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 1024
                      },
                      "inline": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "image_url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "thumbnail_url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "footer": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "icon_url": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                },
                "timestamp": {
                  "type": "boolean"
                }
              }
            }
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Components V2: container accent color."
          },
          "components": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "separator",
                    "media"
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 4000
                },
                "divider": {
                  "type": "boolean"
                },
                "spacing": {
                  "type": "string",
                  "enum": [
                    "small",
                    "large"
                  ]
                },
                "urls": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      },
      "username": {
        "type": "string",
        "maxLength": 80,
        "x-labelKey": "builder.cfg.username",
        "x-hintKey": "builder.cfg.send_webhook_message_username_hint"
      },
      "avatar": {
        "type": "string",
        "maxLength": 2000,
        "x-mono": true,
        "x-labelKey": "builder.cfg.webhook_message_avatar",
        "x-hintKey": "builder.cfg.send_webhook_message_avatar_hint"
      },
      "thread": {
        "type": "string",
        "maxLength": 40,
        "x-advanced": true,
        "x-mono": true,
        "x-labelKey": "builder.cfg.thread",
        "x-hintKey": "builder.cfg.send_webhook_message_thread_hint"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
