{
  "$schema": "../node-definition.schema.json",
  "type": "action.set_unique_variable",
  "version": 1,
  "category": "action",
  "group": "other",
  "order": 790,
  "color": "teal",
  "icon": "▶︎",
  "labelKey": "builder.node.action_set_unique_variable.label",
  "descriptionKey": "builder.node.action_set_unique_variable.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "results": [
    {
      "suffix": "",
      "labelKey": "builder.result.set_unique_variable.0"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "unique_kind": {
        "type": "string",
        "enum": [
          "uuid",
          "number",
          "short",
          "text"
        ],
        "default": "uuid",
        "x-labelKey": "builder.cfg.unique_kind",
        "x-enumKey": "builder.enum.unique_kind"
      },
      "length": {
        "type": "number",
        "minimum": 1,
        "maximum": 200,
        "default": 12,
        "x-labelKey": "builder.cfg.random_length",
        "x-showIf": {
          "unique_kind": [
            "text"
          ]
        }
      },
      "charset": {
        "type": "string",
        "enum": [
          "letters_digits",
          "letters",
          "lowercase",
          "digits",
          "hex",
          "custom"
        ],
        "default": "letters_digits",
        "x-labelKey": "builder.cfg.charset",
        "x-enumKey": "builder.enum.charset",
        "x-showIf": {
          "unique_kind": [
            "text"
          ]
        }
      },
      "custom_chars": {
        "type": "string",
        "maxLength": 200,
        "x-mono": true,
        "x-labelKey": "builder.cfg.custom_chars",
        "x-placeholder": "ABC123!?",
        "x-showIf": {
          "charset": [
            "custom"
          ]
        }
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
