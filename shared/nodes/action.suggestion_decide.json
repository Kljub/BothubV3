{
  "$schema": "../node-definition.schema.json",
  "type": "action.suggestion_decide",
  "version": 1,
  "category": "action",
  "group": "suggestions",
  "order": 1160,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_suggestion_decide.label",
  "descriptionKey": "builder.node.action_suggestion_decide.description",
  "module": "suggestions",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "suggestion": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.suggestion",
        "x-hintKey": "builder.cfg.ref_hint",
        "x-ref": "message"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ],
        "default": "approve",
        "x-labelKey": "builder.cfg.decision",
        "x-enumKey": "builder.enum.decision"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.reason",
        "x-hintKey": "builder.cfg.reason_hint"
      }
    }
  }
}
