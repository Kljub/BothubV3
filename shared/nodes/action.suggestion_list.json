{
  "$schema": "../node-definition.schema.json",
  "type": "action.suggestion_list",
  "version": 1,
  "category": "action",
  "group": "suggestions",
  "order": 1150,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_suggestion_list.label",
  "descriptionKey": "builder.node.action_suggestion_list.description",
  "module": "suggestions",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "suggestion_status": {
        "type": "string",
        "enum": [
          "all",
          "pending",
          "approved",
          "rejected"
        ],
        "default": "pending",
        "x-labelKey": "builder.cfg.suggestion_status",
        "x-enumKey": "builder.enum.suggestion_status"
      },
      "variable": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
        "x-labelKey": "builder.cfg.variable",
        "x-hintKey": "builder.cfg.variable_hint"
      }
    }
  }
}
