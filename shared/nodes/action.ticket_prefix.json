{
  "$schema": "../node-definition.schema.json",
  "type": "action.ticket_prefix",
  "version": 1,
  "category": "action",
  "group": "tickets",
  "order": 1335,
  "color": "green",
  "icon": "▶︎",
  "labelKey": "builder.node.action_ticket_prefix.label",
  "descriptionKey": "builder.node.action_ticket_prefix.description",
  "module": "ticket",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.ticket_channel",
        "x-hintKey": "builder.cfg.ticket_channel_hint",
        "x-ref": "channel",
        "default": "{channel.id}"
      },
      "prefix": {
        "type": "string",
        "maxLength": 30,
        "x-labelKey": "builder.cfg.ticket_prefix",
        "x-hintKey": "builder.cfg.ticket_prefix_hint"
      }
    }
  }
}
