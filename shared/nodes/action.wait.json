{
  "$schema": "../node-definition.schema.json",
  "type": "action.wait",
  "version": 1,
  "category": "action",
  "group": "other",
  "order": 760,
  "color": "purple",
  "icon": "▶︎",
  "labelKey": "builder.node.action_wait.label",
  "descriptionKey": "builder.node.action_wait.description",
  "inputs": [
    {
      "name": "in",
      "type": "flow",
      "labelKey": "builder.port.in",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "wait_mode": {
        "type": "string",
        "enum": [
          "pause",
          "later"
        ],
        "default": "pause",
        "x-labelKey": "builder.cfg.wait_mode",
        "x-enumKey": "builder.enum.wait_mode"
      },
      "duration": {
        "type": "string",
        "maxLength": 20,
        "x-labelKey": "builder.cfg.duration",
        "x-placeholder": "10m",
        "x-hintKey": "builder.cfg.duration_hint"
      },
      "job_id": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.job_id",
        "x-mono": true,
        "x-placeholder": "reminder-{user.id}",
        "x-hintKey": "builder.cfg.job_id_hint",
        "x-showIf": {
          "wait_mode": [
            "later"
          ]
        }
      }
    }
  }
}
