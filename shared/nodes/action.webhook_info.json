    {
      "suffix": ".name",
      "labelKey": "builder.result.webhook_info.2"
    },
    {
      "suffix": ".avatar",
      "labelKey": "builder.result.webhook_info.3"
    },
    {
      "suffix": ".channel",
      "labelKey": "builder.result.webhook_info.4"
    },
    {
      "suffix": ".channel_id",
      "labelKey": "builder.result.webhook_info.5"
    },
    {
      "suffix": ".creator",
      "labelKey": "builder.result.webhook_info.6"
    },
    {
      "suffix": ".created",
      "labelKey": "builder.result.webhook_info.7"
    }
  ],
  "config": {
