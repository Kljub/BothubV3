{
  "$schema": "../node-definition.schema.json",
  "type": "trigger.event",
  "version": 1,
  "category": "trigger",
  "group": "trigger",
  "icon": "📡",
  "labelKey": "builder.node.trigger_event.label",
  "descriptionKey": "builder.node.trigger_event.description",
  "locked": true,
  "inputs": [],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "event",
      "event_name"
    ],
    "properties": {
      "event": {
        "type": "string",
        "enum": [
          "member_join",
          "member_leave",
          "member_ban",
          "member_unban",
          "member_role_add",
          "member_role_remove",
          "member_update",
          "member_nickname",
          "member_status",
          "member_screening",
          "guild_update",
          "message_create",
          "message_update",
          "message_delete",
          "message_pin",
          "typing_start",
          "reaction_add",
          "reaction_remove",
          "reaction_remove_all",
          "reaction_remove_emoji",
          "voice_join",
          "voice_switch",
          "voice_leave",
          "voice_stream_start",
          "voice_stream_stop",
          "voice_mute",
          "voice_unmute",
          "voice_deafen",
          "voice_undeafen",
          "channel_create",
          "channel_update",
          "channel_delete",
          "channel_permissions",
          "channel_topic",
          "channel_pins",
          "thread_create",
          "thread_update",
          "thread_delete",
          "thread_members",
          "role_create",
          "role_update",
          "role_delete",
          "invite_create",
          "invite_delete",
          "boost_start",
          "boost_stop",
          "boost_level_up",
          "boost_level_down",
          "scheduled_create",
          "scheduled_update",
          "scheduled_delete",
          "scheduled_user_add",
          "scheduled_user_remove",
          "scheduled_start",
          "scheduled_end",
          "scheduled_cancel",
          "poll_vote_add",
          "poll_vote_remove",
          "automod_action",
          "automod_rule_create",
          "automod_rule_update",
          "automod_rule_delete",
          "bot_guild_join",
          "bot_guild_leave",
          "bot_ready",
          "bot_variable_change",
          "bot_updated",
          "audit_entry",
          "app_command_permissions",
          "sticker_create",
          "sticker_update",
          "sticker_delete",
          "stage_start",
          "stage_update",
          "stage_end",
          "music_track_start",
          "music_track_end",
          "music_track_skip",
          "music_track_error",
          "music_queue_add",
          "music_queue_remove",
          "music_queue_end",
          "music_pause",
          "music_resume",
          "music_stop",
          "music_volume",
          "music_loop",
          "music_filters",
          "music_player_create",
          "music_player_destroy",
          "music_voice_join",
          "music_voice_leave",
          "music_listener_join",
          "music_listener_leave",
          "webhook",
          "timed",
          "ifttt"
        ],
        "x-widget": "eventType",
        "x-labelKey": "builder.cfg.event_type",
        "x-hintKey": "builder.cfg.event_type_hint"
      },
      "webhook": {
        "type": "string",
        "pattern": "^([a-z0-9]{16,40})?$",
        "x-widget": "webhook",
        "x-labelKey": "builder.cfg.webhook",
        "x-hintKey": "builder.cfg.webhook_hint",
        "x-showIf": {
          "event": [
            "webhook"
          ]
        }
      },
      "event_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "x-labelKey": "builder.cfg.event_name",
        "x-hintKey": "builder.cfg.event_name_hint"
      },
      "timed_event": {
        "type": "string",
        "x-widget": "timedEvent",
        "x-showIf": {
          "event": [
            "timed"
          ]
        },
        "x-labelKey": "builder.cfg.timed_event",
        "x-hintKey": "builder.cfg.timed_event_hint"
      }
    }
  }
}
