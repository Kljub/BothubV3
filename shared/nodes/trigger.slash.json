{
  "$schema": "../node-definition.schema.json",
  "type": "trigger.slash",
  "version": 1,
  "category": "trigger",
  "group": "trigger",
  "icon": "⚡",
  "labelKey": "builder.node.trigger_slash.label",
  "descriptionKey": "builder.node.trigger_slash.description",
  "locked": true,
  "inputs": [
    {
      "name": "options",
      "type": "any",
      "labelKey": "builder.port.options",
      "multiple": true
    }
  ],
  "outputs": [
    {
      "name": "next",
      "type": "flow",
      "labelKey": "builder.port.next"
    }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "command_name"
    ],
    "properties": {
      "command_type": {
        "type": "string",
        "enum": [
          "slash",
          "user",
          "message"
        ],
        "default": "slash",
        "x-labelKey": "builder.cfg.command_type",
        "x-enumKey": "builder.enum.command_type"
      },
      "display_name": {
        "type": "string",
        "maxLength": 64,
        "x-labelKey": "builder.cfg.display_name",
        "x-hintKey": "builder.cfg.display_name_hint"
      },
      "command_name": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,32}( [a-z0-9_-]{1,32}){0,2}$",
        "x-labelKey": "builder.cfg.command_name",
        "x-hintKey": "builder.cfg.command_name_hint"
      },
      "menu_name": {
        "type": "string",
        "maxLength": 32,
        "x-labelKey": "builder.cfg.menu_name",
        "x-hintKey": "builder.cfg.menu_name_hint",
        "x-showIf": {
          "command_type": [
            "user",
            "message"
          ]
        }
      },
      "description": {
        "type": "string",
        "maxLength": 100,
        "x-labelKey": "builder.cfg.description",
        "x-hintKey": "builder.cfg.description_hint",
        "x-showIf": {
          "command_type": [
            "slash"
          ]
        }
      },
      "hide_replies": {
        "type": "boolean",
        "default": false,
        "x-labelKey": "builder.cfg.hide_replies",
        "x-hintKey": "builder.cfg.hide_replies_hint"
      },
      "visibility_option": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{0,32}$",
        "x-labelKey": "builder.cfg.visibility_option",
        "x-hintKey": "builder.cfg.visibility_option_hint",
        "x-advanced": true,
        "x-showIf": {
          "command_type": [
            "slash"
          ]
        }
      },
      "cooldown_type": {
        "type": "string",
        "enum": [
          "none",
          "user",
          "server",
          "global"
        ],
        "default": "none",
        "x-labelKey": "builder.cfg.cooldown_type",
        "x-enumKey": "builder.enum.cooldown"
      },
      "cooldown_seconds": {
        "type": "number",
        "minimum": 1,
        "maximum": 86400,
        "default": 10,
        "x-labelKey": "builder.cfg.cooldown_seconds",
        "x-showIf": {
          "cooldown_type": [
            "user",
            "server",
            "global"
          ]
        }
      },
      "permissions": {
        "type": "object",
        "additionalProperties": false,
        "x-labelKey": "builder.cfg.permissions",
        "x-widget": "permissions",
        "x-permissionGroups": [
          {
            "group": "general",
            "permissions": [
              "view_channel",
              "manage_channels",
              "manage_roles",
              "manage_guild_expressions",
              "create_guild_expressions",
              "view_audit_log",
              "view_guild_insights",
              "manage_webhooks",
              "manage_guild"
            ]
          },
          {
            "group": "membership",
            "permissions": [
              "create_instant_invite",
              "change_nickname",
              "manage_nicknames",
              "kick_members",
              "ban_members",
              "moderate_members"
            ]
          },
          {
            "group": "text",
            "permissions": [
              "send_messages",
              "send_messages_in_threads",
              "create_public_threads",
              "create_private_threads",
              "embed_links",
              "attach_files",
              "add_reactions",
              "use_external_emojis",
              "use_external_stickers",
              "mention_everyone",
              "manage_messages",
              "manage_threads",
              "read_message_history",
              "send_tts_messages",
              "send_voice_messages",
              "send_polls",
              "use_application_commands"
            ]
          },
          {
            "group": "voice",
            "permissions": [
              "connect",
              "speak",
              "stream",
              "use_soundboard",
              "use_external_sounds",
              "use_vad",
              "priority_speaker",
              "mute_members",
              "deafen_members",
              "move_members"
            ]
          },
          {
            "group": "events",
            "permissions": [
              "create_events",
              "manage_events"
            ]
          },
          {
            "group": "advanced",
            "permissions": [
              "administrator"
            ]
          }
        ],
        "default": {
          "allowed_roles": [
            {
              "id": "everyone"
            }
          ],
          "banned_roles": [],
          "required_permissions": [],
          "banned_channels": [],
          "hide_without_permission": false
        },
        "properties": {
          "allowed_roles": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(everyone|moderation:moderator|moderation:admin|[0-9]{17,20})$",
                  "description": "Role ID, or \"everyone\" for the @everyone role of every server."
                },
                "guild": {
                  "type": "string",
                  "pattern": "^([0-9]{17,20})?$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "color": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "description": "The member needs one of these roles. \"everyone\" allows every member."
          },
          "banned_roles": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(everyone|moderation:moderator|moderation:admin|[0-9]{17,20})$",
                  "description": "Role ID, or \"everyone\" for the @everyone role of every server."
                },
                "guild": {
                  "type": "string",
                  "pattern": "^([0-9]{17,20})?$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "color": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          },
          "required_permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "view_channel",
                "manage_channels",
                "manage_roles",
                "manage_guild_expressions",
                "create_guild_expressions",
                "view_audit_log",
                "view_guild_insights",
                "manage_webhooks",
                "manage_guild",
                "create_instant_invite",
                "change_nickname",
                "manage_nicknames",
                "kick_members",
                "ban_members",
                "moderate_members",
                "send_messages",
                "send_messages_in_threads",
                "create_public_threads",
                "create_private_threads",
                "embed_links",
                "attach_files",
                "add_reactions",
                "use_external_emojis",
                "use_external_stickers",
                "mention_everyone",
                "manage_messages",
                "manage_threads",
                "read_message_history",
                "send_tts_messages",
                "send_voice_messages",
                "send_polls",
                "use_application_commands",
                "connect",
                "speak",
                "stream",
                "use_soundboard",
                "use_external_sounds",
                "use_vad",
                "priority_speaker",
                "mute_members",
                "deafen_members",
                "move_members",
                "create_events",
                "manage_events",
                "administrator"
              ]
            },
            "description": "Discord permission flags in snake_case; the member needs all of them."
          },
          "banned_channels": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]{17,20}$"
                },
                "guild": {
                  "type": "string",
                  "pattern": "^([0-9]{17,20})?$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "category",
                    "text",
                    "voice",
                    "announcement",
                    "forum",
                    "stage"
                  ]
                }
              }
            }
          },
          "hide_without_permission": {
            "type": "boolean",
            "default": false,
            "description": "Sets default_member_permissions so Discord hides the command."
          }
        }
      },
      "contexts": {
        "type": "string",
        "enum": [
          "guild",
          "guild_dm"
        ],
        "default": "guild",
        "x-labelKey": "builder.cfg.contexts",
        "x-enumKey": "builder.enum.contexts"
      },
      "fail_reply": {
        "type": "string",
        "enum": [
          "friendly",
          "reason",
          "none"
        ],
        "default": "friendly",
        "x-labelKey": "builder.cfg.fail_reply",
        "x-hintKey": "builder.cfg.fail_reply_hint",
        "x-enumKey": "builder.enum.fail_reply"
      },
      "fail_message": {
        "type": "string",
        "maxLength": 500,
        "x-labelKey": "builder.cfg.fail_message",
        "x-placeholder": "Something went wrong while running this command.",
        "x-showIf": {
          "fail_reply": [
            "friendly"
          ]
        }
      },
      "fail_channel": {
        "type": "string",
        "maxLength": 200,
        "x-labelKey": "builder.cfg.fail_channel",
        "x-hintKey": "builder.cfg.fail_channel_hint",
        "x-ref": "channel"
      },
      "fail_flow": {
        "type": "string",
        "enum": [
          "stop",
          "continue"
        ],
        "default": "stop",
        "x-labelKey": "builder.cfg.fail_flow",
        "x-hintKey": "builder.cfg.fail_flow_hint",
        "x-enumKey": "builder.enum.fail_flow"
      },
      "record_runs": {
        "type": "boolean",
        "default": true,
        "x-labelKey": "builder.cfg.record_runs",
        "x-hintKey": "builder.cfg.record_runs_hint",
        "x-advanced": true
      }
    }
  }
}
