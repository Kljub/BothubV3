  "inputs": [],
  "outputs": [
    { "name": "next", "type": "flow", "labelKey": "builder.port.next" },
    { "name": "user", "type": "user", "labelKey": "builder.port.user" },
    { "name": "member", "type": "member", "labelKey": "builder.port.member" },
    { "name": "channel", "type": "channel", "labelKey": "builder.port.channel" },
    { "name": "guild", "type": "guild", "labelKey": "builder.port.guild" }
